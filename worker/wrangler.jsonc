{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "busnavi-realtime",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "REALTIME_COLLECTOR", "class_name": "RealtimeCollector" }]
  },
  "exports": {
    "RealtimeCollector": { "type": "durable-object", "storage": "sqlite" }
  }
}
